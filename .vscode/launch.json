{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug MyProgram Windows",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/SokolTest",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb.exe", // Or full path to your debugger
      "setupCommands": [
        { "description": "Enable pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ],
      "preLaunchTask": "build"
    },
     {
      "name": "Debug MyProgram Mac",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/SokolTest",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "lldb", // Change to "gdb" if you're using GDB
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb/lldb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build"
    },
  ]
}
